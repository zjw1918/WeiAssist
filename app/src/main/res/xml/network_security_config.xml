<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain http is allowed because custom providers may be the user's own server on their network
         (Ollama, vLLM, LM Studio), entered by the user; the form warns about it. Every built-in
         provider and sign-in uses https. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
