<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: the agent's foreground service type. See AgentService and docs/ARCHITECTURE.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: show the "working" notification with its Stop button. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The bash tool runs commands in Termux (Termux.kt); granted by the user, see Termux.SETUP. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Keep the CPU awake while a bash command runs (builds, tests with the screen off). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The file tools on the phone's storage, only when the user picks it in Settings → File access:
         "All files access" on Android 11+, the storage permissions before. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application>
        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device AI assistant carrying out a task the user started (operating other apps through its accessibility service, or waiting for the user to finish signing in to the AI provider in the browser), or receiving the messages the user sends it from Telegram, when they turned that on. The user can stop it from the notification or turn Telegram off in Settings." />
        </service>
    </application>
</manifest>
